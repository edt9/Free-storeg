# TeleCloud Gallery Configuration
# Telegram Bot API credentials
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
TELEGRAM_WEBHOOK_SECRET="optional_webhook_secret_token"

# Admin Authentication & Session
# Default initial admin password is 'admin123' if hash not configured; can be updated in Settings
ADMIN_PASSWORD_HASH=""
SESSION_SECRET="telecloud_session_secret_key_change_in_production_min_32_chars"

# Application & Storage Settings
PORT=3000
DATABASE_PATH="./data/telecloud.db"
MAX_FILE_SIZE_MB=20
MAX_UPLOAD_FILES=10
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

